<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalAI.Desktop.Presentation.ViewModels"
             x:Class="PersonalAI.Desktop.Avalonia.Views.Assist.AssistView"
             x:DataType="vm:AssistPillViewModel"
             KeyDown="OnViewKeyDown"
             AutomationProperties.Name="Assist">

  <Panel>
    <Border x:Name="ExpandedBackground"
            Classes="assistSurface"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            IsVisible="False"
            IsHitTestVisible="False" />

    <!-- The native idle host remains a single 52x52 invokable launcher. -->
    <Button x:Name="CompactPill"
            Classes="assistLauncher"
            IsVisible="False"
            Padding="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="OnAskClick"
            ToolTip.Tip="Ask AEDA"
            AutomationProperties.Name="Ask AEDA">
      <Grid Width="52" Height="52">
        <Viewbox Width="52" Height="52">
          <Grid Width="64" Height="64">
            <Path x:Name="AssistLauncherAura"
                  Classes="launcherAura"
                  Data="{StaticResource AssistOuterGeometry}" />
            <Path x:Name="AssistLauncherGeometry"
                  Classes="launcherSurface"
                  Data="{StaticResource AssistOuterGeometry}" />
            <Viewbox x:Name="AssistIdleMark"
                     Width="20" Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="0,-2,0,0"
                     IsHitTestVisible="False">
              <Canvas Width="24" Height="24">
                <Path Classes="launcherGlyph"
                      Data="{StaticResource AedaEyeGeometry}" />
                <Ellipse Classes="launcherIris" Width="7" Height="7"
                         Canvas.Left="8.5" Canvas.Top="8.5" />
                <Ellipse Classes="launcherPupil" Width="2" Height="2"
                         Canvas.Left="11" Canvas.Top="11" />
              </Canvas>
            </Viewbox>
          </Grid>
        </Viewbox>
      </Grid>
    </Button>

    <Grid x:Name="FullSurface"
          Margin="32"
          RowDefinitions="Auto,*"
          RowSpacing="24">
      <StackPanel x:Name="ModuleHeader" Spacing="6">
        <TextBlock x:Name="ModuleTitle"
                   Text="Assist"
                   FontSize="28"
                   FontWeight="SemiBold" />
        <TextBlock Text="Get quick help with selected text or ask AEDA a question."
                   Classes="metadata"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border x:Name="StateSurface"
              Grid.Row="1"
              Classes="assistSurface"
              MaxWidth="860"
              Padding="24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="{DynamicResource CardSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="14">
        <Grid x:Name="StateLayout" RowDefinitions="Auto,*" RowSpacing="18">
          <!-- Mounted once for every visible Assist state. Its changing text is the
               sole polite announcement source. -->
          <Grid x:Name="StatusRow" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Grid x:Name="ExpandedIdentity"
                  Classes="assistIdentity"
                  Width="44" Height="44"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
              <Viewbox x:Name="ExpandedIdentityViewbox" Width="44" Height="44">
                <Grid Width="64" Height="64">
                  <Path Classes="identityAura"
                        Data="{StaticResource AssistOuterGeometry}" />
                  <Path Classes="identitySurface"
                        Data="{StaticResource AssistOuterGeometry}" />
                  <Viewbox Width="20" Height="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-2,0,0">
                    <Canvas Width="24" Height="24">
                      <Path Classes="identityGlyph"
                            Data="{StaticResource AedaEyeGeometry}" />
                      <Ellipse Classes="identityIris" Width="7" Height="7"
                               Canvas.Left="8.5" Canvas.Top="8.5" />
                      <Ellipse Classes="identityPupil" Width="2" Height="2"
                               Canvas.Left="11" Canvas.Top="11" />
                    </Canvas>
                  </Viewbox>

                  <Ellipse x:Name="AssistListeningMark"
                           Classes="identityMarkOutline"
                           Width="25" Height="25"
                           StrokeThickness="2"
                           IsVisible="False"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                  <StackPanel x:Name="AssistThinkingMark"
                              Classes="identityDots"
                              IsVisible="False"
                              Orientation="Horizontal"
                              Spacing="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,24,0,0">
                    <Ellipse Classes="identityMark dotOne" Width="3" Height="3" />
                    <Ellipse Classes="identityMark dotTwo" Width="3" Height="3" />
                    <Ellipse Classes="identityMark dotThree" Width="3" Height="3" />
                  </StackPanel>
                  <Path x:Name="AssistActionReadyMark"
                        Classes="identityMarkOutline"
                        IsVisible="False"
                        Data="M1,5 L4,8 L10,1"
                        Width="11" Height="9"
                        Stretch="Uniform"
                        StrokeThickness="2.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,11,13" />
                  <Grid x:Name="AssistErrorMark"
                        IsVisible="False"
                        Width="6" Height="13"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,13,12">
                    <Path Classes="identityMarkOutline"
                          Data="M3,1 L3,7"
                          StrokeThickness="2.5" />
                    <Ellipse Classes="identityMark" Width="3" Height="3"
                             VerticalAlignment="Bottom" />
                  </Grid>
                  <Path x:Name="AssistCancelledMark"
                        Classes="identityMarkOutline"
                        IsVisible="False"
                        Data="M1,1 L9,1"
                        Width="10" Height="2"
                        Stretch="Uniform"
                        StrokeThickness="2.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,11,15" />
                </Grid>
              </Viewbox>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="{Binding StatusText}"
                       Classes="metadata"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
          </Grid>

          <Panel x:Name="StateHost" Grid.Row="1">
            <TextBlock x:Name="DisabledSurface"
                       Text="Assist is disabled in Settings."
                       Classes="metadata"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       VerticalAlignment="Top" />

            <StackPanel x:Name="IdleSurface"
                        Spacing="10"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsIdle}">
              <TextBlock Text="AEDA checks selected text first. When no useful text is available, you can type a question."
                         Classes="metadata"
                         TextWrapping="Wrap"
                         MaxWidth="620"
                         HorizontalAlignment="Left" />
              <Button x:Name="AskButton"
                      Content="Ask AEDA"
                      Click="OnAskClick"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="Start Assist"
                      AutomationProperties.Name="Ask AEDA" />
            </StackPanel>

            <StackPanel x:Name="PromptSurface"
                        Spacing="10"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsFallbackInput}">
              <TextBox x:Name="PromptBox"
                       Text="{Binding Prompt, Mode=TwoWay}"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap"
                       MinHeight="40"
                       PlaceholderText="Ask a question…"
                       KeyDown="OnPromptKeyDown"
                       AutomationProperties.Name="Assist prompt" />
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="SendButton"
                        Content="Send"
                        Command="{Binding SubmitCommand}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Send (Enter)"
                        AutomationProperties.Name="Send prompt" />
                <Button x:Name="SelectScreenTextButton"
                        Content="Select screen text"
                        Command="{Binding SelectScreenTextCommand}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Capture text from the screen"
                        AutomationProperties.Name="Select screen text" />
              </WrapPanel>
            </StackPanel>

            <Grid x:Name="ResponseSurface"
                  RowDefinitions="*,Auto"
                  RowSpacing="10"
                  IsVisible="{Binding IsResponseSurface}">
              <Grid x:Name="ResponseRegion"
                    RowDefinitions="Auto,*"
                    RowSpacing="8"
                    IsVisible="{Binding HasResponse}">
                <TextBlock Text="Response" Classes="sectionHeading" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <SelectableTextBlock x:Name="ResponseText"
                                       Text="{Binding Response}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Assist response" />
                </ScrollViewer>
              </Grid>

              <WrapPanel x:Name="ResponseActions"
                         Grid.Row="1"
                         Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding CanCancel}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Stop generating (Escape)"
                        AutomationProperties.Name="Cancel generation" />
                <Button x:Name="RetryButton"
                        Content="Retry"
                        Command="{Binding RetryCommand}"
                        IsVisible="{Binding CanRetry}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Retry"
                        AutomationProperties.Name="Retry" />
                <Button x:Name="CopyButton"
                        Content="Copy"
                        Command="{Binding CopyResponseCommand}"
                        IsVisible="{Binding CanShowResponseActions}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Copy response"
                        AutomationProperties.Name="Copy response" />
                <Button x:Name="OpenInAedaButton"
                        Content="Open in AEDA"
                        Command="{Binding OpenInAedaCommand}"
                        IsVisible="{Binding CanShowResponseActions}"
                        Margin="0,0,8,8"
                        ToolTip.Tip="Open this reply in AEDA"
                        AutomationProperties.Name="Open in AEDA" />
              </WrapPanel>
            </Grid>
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Panel>
</UserControl>
