<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalAI.Desktop.Presentation.ViewModels"
             x:Class="PersonalAI.Desktop.Avalonia.Views.Assist.AssistView"
             x:DataType="vm:AssistPillViewModel"
             KeyDown="OnViewKeyDown"
             AutomationProperties.Name="Assist">

  <Panel>
    <Border x:Name="ExpandedBackground"
            Classes="assistSurface"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            IsVisible="False" />

    <!-- Compact host, idle: a lightweight rounded-triangle vector. -->
    <Button x:Name="CompactPill"
            Classes="assistLauncher"
            IsVisible="False"
            Padding="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="OnAskClick"
            ToolTip.Tip="Ask AEDA"
            AutomationProperties.Name="Ask AEDA">
      <Grid Width="52" Height="52">
        <Path x:Name="AssistLauncherGeometry"
              Classes="launcherSurface"
              Data="M 26,3 C 30,3 32,6 34,10 L 48,36 C 52,43 47,49 39,49 L 13,49 C 5,49 0,43 4,36 L 18,10 C 20,6 22,3 26,3 Z" />
        <Border Width="20"
                Height="20"
                CornerRadius="7"
                Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <TextBlock Text="A"
                     Foreground="White"
                     FontSize="12"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Button>

  <Grid x:Name="FullSurface" Margin="28" RowDefinitions="Auto,*" RowSpacing="18">
    <StackPanel x:Name="ModuleHeader" Spacing="4">
      <TextBlock Text="Assist" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding StatusText}"
                 Classes="metadata"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Assist status"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <!-- The three states are mutually exclusive, so a Panel overlays them and passes the
         finite available height straight through. A StackPanel here would measure each
         child with infinite height, which is what pushed the response action row outside
         the bounded Assist window. -->
    <Panel Grid.Row="1">

      <!-- Idle state -->
      <StackPanel Spacing="8" VerticalAlignment="Top" IsVisible="{Binding IsIdle}">
        <TextBlock Text="Ready" Classes="sectionHeading" />
        <TextBlock Text="Ask AEDA to explain selected content or answer a question."
                   Classes="metadata"
                   TextWrapping="Wrap" />
        <Button x:Name="AskButton"
                Content="Ask AEDA"
                Click="OnAskClick"
                HorizontalAlignment="Left"
                ToolTip.Tip="Start Assist"
                AutomationProperties.Name="Ask AEDA" />
      </StackPanel>

      <!-- Spotlight prompt state -->
      <StackPanel Spacing="8" VerticalAlignment="Top" IsVisible="{Binding IsFallbackInput}">
        <TextBlock Text="Ask AEDA" Classes="sectionHeading" />
        <TextBox x:Name="PromptBox"
                 Text="{Binding Prompt, Mode=TwoWay}"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MinHeight="40"
                 PlaceholderText="Ask a question…"
                 KeyDown="OnPromptKeyDown"
                 AutomationProperties.Name="Assist prompt" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="SendButton"
                  Content="Send"
                  Command="{Binding SubmitCommand}"
                  ToolTip.Tip="Send (Enter)"
                  AutomationProperties.Name="Send prompt" />
          <Button x:Name="SelectScreenTextButton"
                  Content="Select screen text"
                  Command="{Binding SelectScreenTextCommand}"
                  ToolTip.Tip="Capture text from the screen"
                  AutomationProperties.Name="Select screen text" />
        </StackPanel>
      </StackPanel>

      <!-- Response / status surface.
           Auto heading, Star scrollable content, Auto actions. The Star row absorbs the
           leftover height, so the response can never grow past the window and hide the
           action row: Copy and Open in AEDA stay inside the host at any response length. -->
      <Grid x:Name="ResponseSurface"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="8"
            IsVisible="{Binding IsResponseSurface}">
        <TextBlock Text="Response" Classes="sectionHeading" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResponseText"
                                Text="{Binding Response}"
                                TextWrapping="Wrap"
                                AutomationProperties.Name="Assist response"
                                AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>

        <!-- Outside the ScrollViewer, in a fixed Auto row: never scrolls away. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding CanCancel}"
                  ToolTip.Tip="Stop generating (Escape)"
                  AutomationProperties.Name="Cancel generation" />
          <Button x:Name="RetryButton"
                  Content="Retry"
                  Command="{Binding RetryCommand}"
                  IsVisible="{Binding CanRetry}"
                  ToolTip.Tip="Retry"
                  AutomationProperties.Name="Retry" />
          <Button x:Name="CopyButton"
                  Content="Copy"
                  Command="{Binding CopyResponseCommand}"
                  IsVisible="{Binding CanShowResponseActions}"
                  ToolTip.Tip="Copy response"
                  AutomationProperties.Name="Copy response" />
          <Button x:Name="OpenInAedaButton"
                  Content="Open in AEDA"
                  Command="{Binding OpenInAedaCommand}"
                  IsVisible="{Binding CanShowResponseActions}"
                  ToolTip.Tip="Open this reply in AEDA"
                  AutomationProperties.Name="Open in AEDA" />
        </StackPanel>
      </Grid>

    </Panel>
  </Grid>
  </Panel>
</UserControl>
