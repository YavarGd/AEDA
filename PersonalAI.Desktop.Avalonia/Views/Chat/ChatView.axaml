<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalAI.Desktop.Avalonia.ViewModels.Chat"
             xmlns:views="using:PersonalAI.Desktop.Avalonia.Views.Chat"
             xmlns:core="using:PersonalAI.Core.Chat"
             x:Class="PersonalAI.Desktop.Avalonia.Views.Chat.ChatView"
             x:DataType="vm:AvaloniaChatViewModel">
  <Grid ColumnDefinitions="280,*">

    <!-- Conversation list -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource AedaBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Conversations" Classes="sectionHeading" />

        <StackPanel Grid.Row="1" Margin="0,10" Spacing="8">
          <TextBox x:Name="SearchBox"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Search conversations"
                   ToolTip.Tip="Search conversations by title"
                   AutomationProperties.Name="Search conversations" />
          <Button x:Name="NewChatButton"
                  Command="{Binding NewChatCommand}"
                  Click="OnNewChatClick"
                  Content="New chat"
                  HorizontalAlignment="Stretch"
                  ToolTip.Tip="Start a new chat (Ctrl+N)"
                  AutomationProperties.Name="Start a new chat" />
        </StackPanel>

        <ListBox x:Name="ConversationList"
                 Grid.Row="2"
                 ItemsSource="{Binding Conversations}"
                 SelectionChanged="OnConversationSelectionChanged"
                 AutomationProperties.Name="Conversation list">
          <!-- The generated ListBoxItem container, not the template content, supplies the
               ListItem automation name. Without this it falls back to Conversation.ToString(),
               so a screen reader reads the GUID and timestamps instead of the title. -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="core:Conversation">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:Conversation">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="metadata">
                  <Run Text="{Binding Model}" />
                  <Run Text="·" />
                  <Run Text="{Binding Status}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Active conversation -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="16">
      <StackPanel Spacing="2">
        <TextBlock Text="General chat" Classes="sectionHeading" />
        <!-- Neither Name nor LabeledBy is set: both would override the changing status
             text, so UIA reads the live text itself. -->
        <TextBlock x:Name="StatusText"
                   Classes="metadata"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <ScrollViewer x:Name="MessageScroll"
                    Grid.Row="1"
                    Margin="0,12"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Message timeline">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageItem">
              <Border Margin="0,0,0,10"
                      Padding="12"
                      CornerRadius="8"
                      Background="{DynamicResource AedaAssistantBubbleBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="metadata"
                             Text="{Binding Role, Converter={x:Static views:ChatRoleConverters.RoleLabel}}" />

                  <!-- Assistant output is markdown; other roles stay plain text. -->
                  <views:ChatMarkdownPresenter
                      Markdown="{Binding Content}"
                      IsVisible="{Binding Role, Converter={x:Static views:ChatRoleConverters.IsAssistant}}" />
                  <SelectableTextBlock
                      Text="{Binding Content}"
                      TextWrapping="Wrap"
                      IsVisible="{Binding Role, Converter={x:Static views:ChatRoleConverters.IsNotAssistant}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="Composer"
                 Text="{Binding Draft, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 MaxHeight="160"
                 PlaceholderText="Ask AEDA. Enter sends, Shift+Enter adds a line."
                 AutomationProperties.Name="Message composer" />
        <Button x:Name="SendButton"
                Grid.Column="1"
                Command="{Binding SendCommand}"
                Click="OnSendClick"
                Content="Send"
                MinWidth="88"
                VerticalAlignment="Bottom"
                ToolTip.Tip="Send message (Enter)"
                AutomationProperties.Name="Send message" />
        <Button x:Name="StopButton"
                Grid.Column="2"
                Command="{Binding CancelCommand}"
                Content="Stop"
                MinWidth="88"
                VerticalAlignment="Bottom"
                ToolTip.Tip="Stop generating (Escape)"
                AutomationProperties.Name="Stop generating" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
