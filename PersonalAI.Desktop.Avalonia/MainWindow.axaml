<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PersonalAI.Desktop.Avalonia.ViewModels.Chat"
        xmlns:chat="using:PersonalAI.Desktop.Avalonia.Views.Chat"
        xmlns:dashboard="using:PersonalAI.Desktop.Avalonia.Views.Dashboard"
        x:Class="PersonalAI.Desktop.Avalonia.MainWindow"
        x:DataType="vm:AvaloniaChatViewModel"
        Title="AEDA"
        Width="1080"
        Height="760"
        MinWidth="640"
        MinHeight="560"
        Icon="/Assets/AedaAppIcon.ico"
        AutomationProperties.Name="AEDA main window">

  <!-- Split-bars shell. Module views remain mounted unchanged in the center host. -->
  <Grid x:Name="ShellGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>
    <Border x:Name="TopShellRegion"
            Grid.Row="0"
            Background="{DynamicResource ShellSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            BoxShadow="{DynamicResource ShellElevation}">
      <Grid x:Name="TopBarLayout" Margin="32,0" ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Path x:Name="BrandMark"
                Data="{StaticResource AedaMarkGeometry}"
                Fill="{DynamicResource AccentBrush}"
                Width="24"
                Height="24"
                Stretch="Uniform"
                IsHitTestVisible="False"
                AutomationProperties.Name="AEDA mark" />
          <TextBlock x:Name="BrandWordmark"
                     Text="AEDA"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- No global search command exists in this milestone; show page context only. -->
        <Border x:Name="PageContextRegion"
                Grid.Column="1"
                MaxWidth="420"
                Margin="16,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsTabStop="False"
                AutomationProperties.Name="Current page">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="BreadcrumbBrand"
                       Text="AEDA"
                       Foreground="{DynamicResource TertiaryTextBrush}" />
            <TextBlock x:Name="BreadcrumbSeparator"
                       Text="/"
                       Foreground="{DynamicResource TertiaryTextBrush}" />
            <TextBlock x:Name="PageTitle"
                       Text="Home"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource ContentSurfaceBrush}">
      <!-- One content host; existing views, scrolling and data contexts are preserved. -->
      <Grid>
        <dashboard:DashboardView x:Name="DashboardRoute" />
        <chat:ChatView x:Name="ChatRoute" IsVisible="False" />
        <ContentControl x:Name="PresentationRoute" IsVisible="False" />
      </Grid>
    </Border>

    <Border x:Name="BottomShellRegion"
            Grid.Row="2"
            Background="{DynamicResource ShellSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <!-- Horizontal scrolling retains every named destination at compact widths. -->
      <ListBox x:Name="NavigationList"
               Classes="shellNavigation"
               Margin="8,0"
               HorizontalAlignment="Center"
               SelectionChanged="OnNavigationSelectionChanged"
               AutomationProperties.Name="Main navigation">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem x:Name="DashboardNavItem"
                     AutomationProperties.Name="Home" />
        <ListBoxItem x:Name="ChatNavItem"
                     AutomationProperties.Name="General chat" />
        <!-- Registered Code, Memory, Research, Task Center, Assist and Settings routes
             are appended without changing their commands, views or data contexts. -->
      </ListBox>
    </Border>
  </Grid>
</Window>
