<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ListBox.shellNavigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="ListBox.shellNavigation ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource MinimumTargetSize}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="2,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Bold text plus a persistent lower marker makes selection non-color-only. -->
  <Style Selector="ListBox.shellNavigation ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Window.medium ListBox.shellNavigation ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Window.compact ListBox.shellNavigation ListBoxItem">
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
