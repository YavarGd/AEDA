<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Button:focus-visible, TextBox:focus-visible, ComboBox:focus-visible, ListBox:focus-visible, ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.actionPrimary, Button.actionSecondary, Button.actionUtility, Button.actionCautionary">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style Selector="Button.actionPrimary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.actionPrimary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.actionPrimary:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.actionSecondary">
    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.actionSecondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>
  <Style Selector="Button.actionSecondary:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
  </Style>

  <Style Selector="Button.actionUtility">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.actionUtility:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.actionUtility:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.actionCautionary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.actionCautionary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
  </Style>
  <Style Selector="Button.actionCautionary:pressed">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>

  <Style Selector="Button.actionPrimary:disabled, Button.actionSecondary:disabled, Button.actionUtility:disabled, Button.actionCautionary:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.actionPrimary:focus-visible, Button.actionSecondary:focus-visible, Button.actionUtility:focus-visible, Button.actionCautionary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBlock.metadata">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.sectionHeading">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
