<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Runtime theme selection replaces these semantic defaults in one place. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF0F2" />
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#EEF0F2" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EBF3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B222A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6572" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8A93A0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A93A0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E6" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#DCE1E6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C6FA0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C6FA0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4C6FA0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3E8F5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B4842A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B4483E" />
    <SolidColorBrush x:Key="ListeningBrush" Color="#2E86A8" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4C6FA0" />

    <!-- Canonical horizontal eye silhouette traced from AedaAppIcon.ico. -->
    <StreamGeometry x:Key="AedaEyeGeometry">
      M2,12 C7,7 13,4.5 22,12 C13,19.5 7,17 2,12 Z
    </StreamGeometry>
    <StreamGeometry x:Key="AssistOuterGeometry">
      M32 6 C34.2 6 36.2 7.2 37.3 9.2 L56.4 44.3
      C58.6 48.2 55.8 53 51.3 53 L12.7 53
      C8.2 53 5.4 48.2 7.6 44.3 L26.7 9.2 C27.8 7.2 29.8 6 32 6 Z
    </StreamGeometry>

    <!-- Compatibility aliases keep existing module interiors untouched. -->
    <SolidColorBrush x:Key="AedaNavBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="AedaBorderBrush" Color="#D7DBE2" />
    <SolidColorBrush x:Key="AedaUserBubbleBrush" Color="#E5ECF5" />
    <SolidColorBrush x:Key="AedaAssistantBubbleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AedaCodeBackgroundBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="AedaMetadataBrush" Color="#737B85" />
    <SolidColorBrush x:Key="AedaFocusBrush" Color="#2E73C8" />

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <x:Double x:Key="Space6">32</x:Double>
    <x:Double x:Key="Space7">48</x:Double>
    <x:Double x:Key="Space8">64</x:Double>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">9</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <x:Double x:Key="TopShellHeight">64</x:Double>
    <x:Double x:Key="BottomShellHeight">72</x:Double>
    <x:Double x:Key="ShellIconSize">20</x:Double>
    <x:Double x:Key="InlineIconSize">16</x:Double>
    <x:Double x:Key="MinimumTargetSize">40</x:Double>
    <x:Double x:Key="NavigationTargetSize">48</x:Double>
    <BoxShadows x:Key="ShellElevation">0 2 12 0 #18000000</BoxShadows>
  </Styles.Resources>
</Styles>
