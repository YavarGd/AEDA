<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Runtime theme selection replaces these semantic defaults in one place. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FBFCFE" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#F8F9FB" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#E9EDF2" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D2025" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#505862" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#737B85" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7DBE2" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#B9C0CA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4B76A8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3E6898" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#31577F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5C8A57" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B77A2F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B44949" />
    <SolidColorBrush x:Key="ListeningBrush" Color="#2F91B8" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#2E73C8" />

    <!-- Compatibility aliases keep existing module interiors untouched. -->
    <SolidColorBrush x:Key="AedaNavBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="AedaBorderBrush" Color="#D7DBE2" />
    <SolidColorBrush x:Key="AedaUserBubbleBrush" Color="#E5ECF5" />
    <SolidColorBrush x:Key="AedaAssistantBubbleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AedaCodeBackgroundBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="AedaMetadataBrush" Color="#737B85" />
    <SolidColorBrush x:Key="AedaFocusBrush" Color="#2E73C8" />

    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <x:Double x:Key="TopShellHeight">64</x:Double>
    <x:Double x:Key="BottomShellHeight">64</x:Double>
    <x:Double x:Key="ShellIconSize">18</x:Double>
    <x:Double x:Key="MinimumTargetSize">44</x:Double>
    <BoxShadows x:Key="ShellElevation">0 2 12 0 #18000000</BoxShadows>
  </Styles.Resources>
</Styles>
