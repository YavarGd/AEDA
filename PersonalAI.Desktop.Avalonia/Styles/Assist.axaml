<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.assistLauncher">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.assistLauncher Path.launcherAura">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="StrokeThickness" Value="6" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style Selector="Button.assistLauncher Path.launcherSurface">
    <Setter Property="Fill" Value="{DynamicResource ElevatedSurfaceBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Button.assistLauncher Path.launcherGlyph">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher Ellipse.launcherMark">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher Path.launcherMarkOutline, Button.assistLauncher Ellipse.launcherMarkOutline">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Button.assistLauncher:pointerover Path.launcherSurface">
    <Setter Property="Fill" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <Style Selector="Button.assistLauncher:pointerover Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="Opacity" Value="0.3" />
  </Style>

  <Style Selector="Button.assistLauncher:focus-visible Path.launcherSurface">
    <Setter Property="Stroke" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>

  <Style Selector="Button.assistLauncher:focus-visible Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="StrokeThickness" Value="8" />
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.assistLauncher:pressed">
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="Button.assistLauncher:pressed Path.launcherSurface">
    <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.listening Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource ListeningBrush}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="Opacity" Value="0.34" />
  </Style>

  <Style Selector="Button.assistLauncher.listening Path.launcherSurface">
    <Setter Property="Stroke" Value="{DynamicResource ListeningBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.listening Path.launcherGlyph, Button.assistLauncher.listening Ellipse.launcherMark">
    <Setter Property="Fill" Value="{DynamicResource ListeningBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.listening Path.launcherMarkOutline, Button.assistLauncher.listening Ellipse.launcherMarkOutline">
    <Setter Property="Stroke" Value="{DynamicResource ListeningBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.thinking Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <Style Selector="Button.assistLauncher.thinking Path.launcherSurface">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.thinking Path.launcherGlyph, Button.assistLauncher.thinking Ellipse.launcherMark">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.actionReady Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <Style Selector="Button.assistLauncher.actionReady Path.launcherSurface">
    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.actionReady Path.launcherGlyph">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.actionReady Path.launcherMarkOutline">
    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.error Path.launcherAura">
    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="Opacity" Value="0.32" />
  </Style>

  <Style Selector="Button.assistLauncher.error Path.launcherSurface">
    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher.error Path.launcherGlyph, Button.assistLauncher.error Ellipse.launcherMark, Button.assistLauncher.error Path.launcherMarkOutline">
    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="Button.assistLauncher:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Border.assistSurface.listening">
    <Setter Property="BorderBrush" Value="{DynamicResource ListeningBrush}" />
  </Style>

  <Style Selector="Border.assistSurface.thinking">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.assistSurface.actionReady">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.assistSurface.error">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
</Styles>
